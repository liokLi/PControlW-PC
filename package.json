{
  "name": "pcontrolw-pc",
  "version": "0.1.0",
  "private": true,
  "description": "手机控制电脑 · Windows 桌面端",
  "main": "electron/main.cjs",
  "author": "PControlW",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "node scripts/sync-phone.cjs && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "koffi": "^2.12.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^6.1.0"
  },
  "engines": { "node": ">=22.12.0" },
  "build": {
    "appId": "com.pcontrolw.desktop",
    "productName": "手机控制电脑",
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "phone-web/**/*", "package.json"],
    "asarUnpack": ["node_modules/koffi/**/*"],
    "win": { "icon": "electron/app.ico", "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
